{
  "openapi": "3.1.0",
  "info": {
    "title": "T22 restricted CSV exports",
    "version": "1.1",
    "description": "Requires clinic migrations0008–0009 for optional template fields. Browser must verify full response bytes and checksum; server ready is not proof of client receipt. Clinical CSV includes extra_fields and per-version values. See design20."
  },
  "paths": {
    "/api/exports/clinical-records": {
      "post": {
        "operationId": "exportClinical",
        "summary": "Complete doctor-owned clinical CSV; purpose required",
        "security": [
          {
            "session": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "scope": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "record_refs": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "format": "uuid"
                            },
                            "minItems": 1,
                            "uniqueItems": true
                          }
                        },
                        "required": [
                          "record_refs"
                        ]
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "time_range": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "from": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "to": {
                                "type": "string",
                                "format": "date-time"
                              }
                            },
                            "required": [
                              "from",
                              "to"
                            ]
                          }
                        },
                        "required": [
                          "time_range"
                        ]
                      }
                    ]
                  },
                  "purpose": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "scope",
                  "purpose"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Complete doctor-owned clinical CSV; purpose required",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            },
            "headers": {
              "Content-Encoding": {
                "description": "Optional negotiated gzip; integrity metadata describes decoded CSV.",
                "schema": { "type": "string", "enum": ["gzip"] }
              },
              "Content-Length": {
                "description": "HTTP representation length in transmitted bytes; gzip may differ from X-Byte-Count.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Byte-Count": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-Content-SHA256": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Export-Ref": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "X-Record-Count": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "401": {
            "description": "JSON error; see design20"
          },
          "403": {
            "description": "JSON error; see design20"
          },
          "405": {
            "description": "JSON error; see design20"
          },
          "422": {
            "description": "JSON error; see design20"
          },
          "503": {
            "description": "JSON error; see design20"
          }
        }
      }
    },
    "/api/exports/alert-hits": {
      "post": {
        "operationId": "exportGuardDetail",
        "summary": "Complete doctor-owned hit-detail CSV",
        "security": [
          {
            "session": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "scope": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "encounter_refs": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "minItems": 1,
                        "uniqueItems": true
                      }
                    },
                    "required": [
                      "encounter_refs"
                    ]
                  },
                  "time_range": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "from": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "to": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "required": [
                      "from",
                      "to"
                    ]
                  },
                  "rule_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "handling_state": {
                    "enum": [
                      "unhandled",
                      "handled"
                    ]
                  }
                },
                "required": []
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Complete doctor-owned hit-detail CSV",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            },
            "headers": {
              "Content-Encoding": {
                "description": "Optional negotiated gzip; integrity metadata describes decoded CSV.",
                "schema": { "type": "string", "enum": ["gzip"] }
              },
              "Content-Length": {
                "description": "HTTP representation length in transmitted bytes; gzip may differ from X-Byte-Count.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Byte-Count": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-Content-SHA256": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Export-Ref": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "X-Record-Count": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "401": {
            "description": "JSON error; see design20"
          },
          "403": {
            "description": "JSON error; see design20"
          },
          "405": {
            "description": "JSON error; see design20"
          },
          "422": {
            "description": "JSON error; see design20"
          },
          "503": {
            "description": "JSON error; see design20"
          }
        }
      }
    },
    "/api/exports/alert-summary": {
      "post": {
        "operationId": "exportGuardSummary",
        "summary": "Current-store manager summary CSV",
        "security": [
          {
            "session": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "time_range": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "from": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "to": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "required": [
                      "from",
                      "to"
                    ]
                  },
                  "rule_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "handling_state": {
                    "enum": [
                      "unhandled",
                      "handled"
                    ]
                  },
                  "group_by": {
                    "enum": [
                      "rule",
                      "handling_state"
                    ]
                  }
                },
                "required": []
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current-store manager summary CSV",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            },
            "headers": {
              "Content-Encoding": {
                "description": "Optional negotiated gzip; integrity metadata describes decoded CSV.",
                "schema": { "type": "string", "enum": ["gzip"] }
              },
              "Content-Length": {
                "description": "HTTP representation length in transmitted bytes; gzip may differ from X-Byte-Count.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Byte-Count": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-Content-SHA256": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Export-Ref": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "X-Record-Count": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "401": {
            "description": "JSON error; see design20"
          },
          "403": {
            "description": "JSON error; see design20"
          },
          "405": {
            "description": "JSON error; see design20"
          },
          "422": {
            "description": "JSON error; see design20"
          },
          "503": {
            "description": "JSON error; see design20"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid"
      }
    }
  }
}
