{
  "openapi": "3.1.0",
  "info": {
    "title": "T22 suggestion backend slice",
    "version": "0.1.0",
    "description": "Only the three implemented suggestion routes. Session login and CSRF bootstrap currently use existing / and /api/login; not a complete system OpenAPI. Synthetic data only; no model connection."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:18730"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/api/clinical/encounters/{encounter_id}/suggestions": {
      "get": {
        "summary": "Read assigned encounter suggestions",
        "parameters": [
          {
            "name": "encounter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/List"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Role/scope errors are JSON. Django CSRF rejection can be text/html.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/clinical/suggestions/{suggestion_id}/adoption": {
      "post": {
        "summary": "Adopt once through current policy guards",
        "parameters": [
          {
            "name": "suggestion_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Role/scope errors are JSON. Django CSRF rejection can be text/html.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfHeader": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Adoption"
              }
            }
          }
        }
      }
    },
    "/api/clinical/suggestions/{suggestion_id}/decline": {
      "post": {
        "summary": "Retain declined suggestion without clinical write",
        "parameters": [
          {
            "name": "suggestion_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Role/scope errors are JSON. Django CSRF rejection can be text/html.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfHeader": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Decline"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid"
      },
      "csrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRFToken"
      }
    },
    "schemas": {
      "Medication": {
        "type": "object",
        "properties": {
          "drug": {
            "type": "string",
            "maxLength": 2000
          },
          "amount": {
            "type": "string",
            "maxLength": 256
          },
          "unit": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "AdoptedContent": {
        "type": "object",
        "properties": {
          "diagnosis": {
            "type": "string",
            "maxLength": 10000
          },
          "examination": {
            "type": "string",
            "maxLength": 10000
          },
          "medication": {
            "$ref": "#/components/schemas/Medication"
          },
          "original_version_ref": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "Adoption": {
        "type": "object",
        "properties": {
          "encounter_ref": {
            "type": "string",
            "format": "uuid"
          },
          "suggestion_ref": {
            "type": "string",
            "format": "uuid"
          },
          "record_ref": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string",
            "maxLength": 2000
          },
          "adopted_content": {
            "$ref": "#/components/schemas/AdoptedContent"
          }
        },
        "required": [
          "encounter_ref",
          "suggestion_ref",
          "adopted_content"
        ],
        "additionalProperties": false,
        "description": "Business-required nonblank reason is enforced by SR-04 and returns GUARD_BLOCKED when absent. Existing records require record_ref and adopted_content.original_version_ref. First record requires diagnosis. At least one clinical field is required."
      },
      "Decline": {
        "type": "object",
        "properties": {
          "encounter_ref": {
            "type": "string",
            "format": "uuid"
          },
          "suggestion_ref": {
            "type": "string",
            "format": "uuid"
          },
          "record_ref": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string",
            "maxLength": 2000
          },
          "decision": {
            "const": "declined"
          }
        },
        "required": [
          "encounter_ref",
          "suggestion_ref",
          "decision"
        ],
        "additionalProperties": false
      },
      "Result": {
        "type": "object",
        "properties": {
          "saved_ref": {
            "type": "string",
            "format": "uuid"
          },
          "record_ref": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "version_ref": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "operation_state": {
            "enum": [
              "adopted",
              "declined"
            ]
          },
          "responsibility_metadata": {
            "type": "object",
            "properties": {
              "actor_ref": {
                "type": "integer"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "actor_ref",
              "created_at"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "saved_ref",
          "record_ref",
          "version_ref",
          "operation_state",
          "responsibility_metadata"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "ok": {
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "additionalProperties": false
          },
          "event_ref": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "ok",
          "error"
        ],
        "additionalProperties": false
      },
      "Source": {
        "type": "object",
        "properties": {
          "type": {
            "const": "demo"
          },
          "version": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "generation_method": {
            "const": "synthetic_fixture"
          }
        },
        "required": [
          "type",
          "version",
          "label",
          "generation_method"
        ],
        "additionalProperties": false
      },
      "Decision": {
        "type": "object",
        "properties": {
          "decision_ref": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "enum": [
              "adopted",
              "declined"
            ]
          },
          "actor_ref": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string"
          },
          "adopted_content": {
            "$ref": "#/components/schemas/AdoptedContent"
          },
          "record_ref": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "version_ref": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "medication_ref": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        },
        "required": [
          "decision_ref",
          "outcome",
          "actor_ref",
          "created_at",
          "reason",
          "adopted_content",
          "record_ref",
          "version_ref",
          "medication_ref"
        ],
        "additionalProperties": false
      },
      "Suggestion": {
        "type": "object",
        "properties": {
          "suggestion_ref": {
            "type": "string",
            "format": "uuid"
          },
          "encounter_ref": {
            "type": "string",
            "format": "uuid"
          },
          "content": {
            "$ref": "#/components/schemas/AdoptedContent"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "status": {
            "enum": [
              "pending",
              "adopted",
              "declined"
            ]
          },
          "decision": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Decision"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "suggestion_ref",
          "encounter_ref",
          "content",
          "source",
          "status",
          "decision"
        ],
        "additionalProperties": false
      },
      "List": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Suggestion"
            }
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      }
    }
  }
}
